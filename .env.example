# Salin jadi .env lalu isi. JANGAN commit file .env.

# --- 1. OPSI UTAMA: 9router AI Gateway (OpenAI-compatible) ---
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=

# --- 2. OPSI ALTERNATIF: Anthropic API Langsung ---
# Kosongkan jika menggunakan 9router. Jika keduanya kosong = mode DEMO (gratis).
ANTHROPIC_API_KEY=

# Kode yang harus dimasukkan pengunjung sebelum bisa chat (opsional untuk internal).
ACCESS_CODE=

PORT=3001

# Model yang aktif di 9router / xKiro
MODEL_LEADER=openai/gpt-6.1-sol
MODEL_TEAM=anthropic/claude-sonnet-4.5

# Pengaman biaya & kuota
MAX_TOKENS=1500
RATE_PER_MINUTE=15
DAILY_MAX_REQUESTS=300
