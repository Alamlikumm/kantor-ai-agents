# Konfigurasi Kantor AI Navigate - PT Feihong Trading International
# Salin file ini menjadi .env (JANGAN commit file .env ke Git)

# --- 1. AI Gateway & LLM Engine (OpenAI-compatible / 9router) ---
ROUTER_BASE_URL=https://ai-feihong.my.id/v1
ROUTER_API_KEY=
MODEL_LEADER=hermes
MODEL_TEAM=hermes

# Fallback direct Anthropic (opsional jika tidak pakai router)
ANTHROPIC_API_KEY=

# --- 2. Keamanan & Akses Web ---
# Wajib diisi! Jika diisi, web akan otomatis terkunci dengan pop-up kode akses.
ACCESS_CODE=kode_rahasia_anda_disini

PORT=3001
MAX_TOKENS=1500
RATE_PER_MINUTE=60
DAILY_MAX_REQUESTS=1000

# --- 3. Database PostgreSQL (Host VPS / Docker) ---
# Jika deploy via Docker Compose di VPS, gunakan: PG_HOST=host.docker.internal
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=kantor_ai
PG_USER=postgres
PG_PASSWORD=postgres

# --- 4. Supabase (Katalog, Stok, Leads Navigate) ---
SUPABASE_URL=https://nakvxtnyrytiudtniqtt.supabase.co
SUPABASE_KEY=

